{
  "name": "so-cash-contracts",
  "private": true,
  "type": "module",
  "workspaces": [
    "sc-so-cash",
    "sc-so-cash-referentials",
    "shared"
  ],
  "devDependencies": {
    "@types/node": "^20.11.30",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^9.0.11",
    "lerna": "^8.1.9",
    "prettier": "^3.2.5",
    "ts-fences": "^0.2.0"
  },
  "scripts": {
    "start": "lerna run start --parallel",
    "dev": "lerna run dev --parallel",
    "build": "lerna run build --parallel",
    "formatter:check": "prettier . --check",
    "formatter:exec": "prettier --write --list-different ."
  },
  "mocha": {
    "extension": "ts",
    "spec": [
      "**/tests/*.spec.ts"
    ],
    "recursive": true,
    "exclude": [
      "node_modules/**/*",
      "*.ignore.ts"
    ],
    "node-option": [
      "experimental-specifier-resolution=node",
      "loader=ts-node/esm"
    ]
  },
  "dependencies": {}
}
